+	status = "okay";
+	interrupt-controller;
+	#interrupt-cells = <2>;
+};
+
+&cp0_xmdio {
+	status = "okay";
+};
+
+&cp0_mdio {
+	pinctrl-names = "ge";
+	pinctrl-0 = <&cp0_ge_mdio_pins>;
+	status = "okay";
+
+	#address-cells = <1>;
+	#size-cells = <0>;
