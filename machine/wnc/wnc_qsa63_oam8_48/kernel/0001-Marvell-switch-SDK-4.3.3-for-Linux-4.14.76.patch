+static inline struct cptlfs_info *get_lfs_info(struct pci_dev *pdev)
+{
+	struct cptpf_dev *cptpf;
+	struct cptvf_dev *cptvf;
+
+	if (pdev->is_physfn) {
+		cptpf = (struct cptpf_dev *) pci_get_drvdata(pdev);
+		return &cptpf->lfs;
+	}
+
+	cptvf = (struct cptvf_dev *) pci_get_drvdata(pdev);
+	return &cptvf->lfs;
+}
