+static int bgx_lmac_link_bring_up(struct bgx *bgx, struct lmac *lmac)
+{
+	int lmacid = lmac->lmacid;
+	int ret = 0;
+	u64 cfg;
+
+	if (lmac->is_sgmii) {
+		ret = bgx_lmac_sgmii_init(bgx, lmac);
+		if (ret) {
+			dev_err(&bgx->pdev->dev, "BGX %d LMAC %d init failed\n",
+				bgx->bgx_id, lmacid);
+			goto out;
+		}
+		/* Manually changing up the link state as there is no poll
+		 * function to do the job, unlike xaui/xlaui.
+		 */
+		lmac->link_up = true;
+		lmac->last_speed = 1000;
+		lmac->last_duplex = 1;
+		lmac->last_link = lmac->link_up;
+		bgx_sgmii_change_link_state(lmac);
+	} else {
+		ret = bgx_lmac_xaui_init(bgx, lmac);
+		if (ret) {
+			dev_err(&bgx->pdev->dev, "BGX %d LMAC %d init failed\n",
+				bgx->bgx_id, lmacid);
+			goto out;
+		}
+	}
+
+	cfg = bgx_reg_read(bgx, lmacid, BGX_CMRX_CFG);
+	cfg |= CMR_PKT_RX_EN | CMR_PKT_TX_EN;
+	bgx_reg_write(bgx, lmacid, BGX_CMRX_CFG, cfg);
+
+out:
+	return ret;
+}
+
+static inline void bgx_lmac_link_down(struct bgx *bgx, struct lmac *lmac)
+{
+	int lmacid = lmac->lmacid;
+	u64 cfg;
+
+	/* Disable packet reception */
+	cfg = bgx_reg_read(bgx, lmacid, BGX_CMRX_CFG);
+	cfg &= ~CMR_PKT_RX_EN;
+	bgx_reg_write(bgx, lmacid, BGX_CMRX_CFG, cfg);
+
+	/* Give chance for Rx/Tx FIFO to get drained */
+	bgx_poll_reg(bgx, lmacid, BGX_CMRX_RX_FIFO_LEN, (u64)0x1FFF, true);
+	bgx_poll_reg(bgx, lmacid, BGX_CMRX_TX_FIFO_LEN, (u64)0x3FFF, true);
+
+	/* Disable packet transmission */
+	cfg = bgx_reg_read(bgx, lmacid, BGX_CMRX_CFG);
+	cfg &= ~CMR_PKT_TX_EN;
+	bgx_reg_write(bgx, lmacid, BGX_CMRX_CFG, cfg);
+
+	/* Disable serdes lanes */
+	if (lmac->is_sgmii)
+		bgx_reg_modify(bgx, lmacid,
+			       BGX_GMP_PCS_MRX_CTL, PCS_MRX_CTL_PWR_DN);
+	else
+		bgx_reg_modify(bgx, lmacid,
+			       BGX_SPUX_CONTROL1, SPU_CTL_LOW_POWER);
+
+	/* Disable LMAC */
+	cfg = bgx_reg_read(bgx, lmacid, BGX_CMRX_CFG);
+	cfg &= ~CMR_EN;
+	bgx_reg_write(bgx, lmacid, BGX_CMRX_CFG, cfg);
+}
+
+static int bgx_lmac_link_bring_down(struct bgx *bgx, struct lmac *lmac)
+{
+	/* Calling lmac link down sequence */
+	bgx_lmac_link_down(bgx, lmac);
+
+	/* Manually changing up the link state as there is no poll
+	 * function to do the job, unlike xaui/xlaui.
+	 */
+	if (lmac->is_sgmii) {
+		lmac->link_up = false;
+		lmac->last_link = lmac->link_up;
+		lmac->last_speed = SPEED_UNKNOWN;
+		lmac->last_duplex = DUPLEX_UNKNOWN;
+		bgx_sgmii_change_link_state(lmac);
+	}
+
+	return 0;
+}
+
+int bgx_set_lmac_link_state(int node, int bgx_idx, int lmacid, bool enable)
+{
+	struct lmac *lmac;
+	struct bgx *bgx;
+	int res = 0;
+
+	bgx = get_bgx(node, bgx_idx);
+	if (!bgx)
+		return -1;
+
+	lmac = &bgx->lmac[lmacid];
+
+	/* If any local or remote fault exists, state cannot be changed */
+	if (!!(bgx_reg_read(lmac->bgx, lmac->lmacid, BGX_SMUX_RX_CTL) &
+	    SMU_RX_CTL_STATUS)) {
+		dev_err(&bgx->pdev->dev, "BGX %d LMAC %d has a fault link state\n",
+			bgx_idx, lmacid);
+		return -1;
+	}
+
+	if (enable) {
+		/* If last link state was down */
+		if (!lmac->last_link)
+			res = bgx_lmac_link_bring_up(bgx, lmac);
+		else /* No operation to perform */
+			dev_info(&bgx->pdev->dev, "BGX %d LMAC %d is already UP\n",
+				 bgx_idx, lmacid);
+	} else {
+		/* If last link state was up */
+		if (lmac->last_link)
+			res = bgx_lmac_link_bring_down(bgx, lmac);
+		else /* No operation to perform */
+			dev_info(&bgx->pdev->dev, "BGX %d LMAC %d is already DOWN\n",
+				 bgx_idx, lmacid);
+	}
+
+	/* Returning zero even if no operation performed */
+	return res;
+}
+EXPORT_SYMBOL(bgx_set_lmac_link_state);
