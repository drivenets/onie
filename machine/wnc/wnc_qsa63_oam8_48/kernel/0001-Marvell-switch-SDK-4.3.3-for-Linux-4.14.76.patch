+#define RX_FIRST_DELAY_REF_MASK		(0xff << RX_FIRST_DELAY_REF_OFFS)
+#define TX_FIRST_DELAY_REF_OFFS		24
+#define TX_FIRST_DELAY_REF_MASK		(0xff << TX_FIRST_DELAY_REF_OFFS)
