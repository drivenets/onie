new file mode 100644
index 00000000..f82596ef
--- /dev/null
+++ b/drivers/ptp/cavium_ptp.c
@@ -0,0 +1,297 @@
+/**********************************************************************
+* Author: Cavium, Inc.
+*
+* Contact: support@cavium.com
+*          Please include "LiquidIO" in the subject.
+*
+* Copyright (c) 2003-2015 Cavium, Inc.
