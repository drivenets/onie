new file mode 100644
index 00000000..9bc8ba67
--- /dev/null
+++ b/drivers/phy/phy-utmi-mvebu.c
@@ -0,0 +1,664 @@
+/*
+ * Marvell UTMI PHY driver
+ *
+ * Copyright (C) 2018 Marvell
