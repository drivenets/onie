+#define LMC_DEVICE_SYMLINK	"device"
+
 static int thunderx_lmc_probe(struct pci_dev *pdev,
 				const struct pci_device_id *id)
 {
@@ -791,6 +793,15 @@ static int thunderx_lmc_probe(struct pci_dev *pdev,
