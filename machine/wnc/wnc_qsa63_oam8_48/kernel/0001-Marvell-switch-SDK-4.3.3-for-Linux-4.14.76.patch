+		     : "=r" (temp) : "r" (high));
+	val = temp;
+	val = val << 32;
+	asm volatile(ALTERNATIVE("ldr %w0, [%1]",
+				 "ldar %w0, [%1]",
+				 ARM64_WORKAROUND_DEVICE_LOAD_ACQUIRE)
+		     : "=r" (temp) : "r" (low));
+	val |= temp;
+
+	return val;
+}
+#endif
 
