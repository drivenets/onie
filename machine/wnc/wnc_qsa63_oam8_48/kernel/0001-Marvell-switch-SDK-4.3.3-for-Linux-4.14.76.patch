+/* stats for /proc/tdm */
+struct avg {
+	u64 count;
+	u64 us;
+	u64 max;
+};
+static struct pstat {
+	u64 sum;
+	u64 drops; /* or empty */
+	u64 irqs;
+	u64 missed[2]; /* missed[severity] */
+	u64 nops;
+	u64 hang;
+	u64 noflo;
+	u64 nolock;
+	struct avg av[2]; /* [1]bind [0]release */
+} pstat[NR_TDM_ENGINES][DIRS];
