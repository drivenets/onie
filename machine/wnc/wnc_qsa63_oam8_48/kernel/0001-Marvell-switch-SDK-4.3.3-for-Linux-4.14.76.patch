+		sw_thr_mask |= (1 << port->uio.q_vector[i].sw_thread_id);
+	}
+	for (i = 0; i < MVPP2_MAX_ADDR_SPACES; i++)
+		if ((sw_thr_mask & BIT(i)) == 0)
+			mv_pp22_isr_rx_group_write(hw, port->id, i, 0, 0);
+}
