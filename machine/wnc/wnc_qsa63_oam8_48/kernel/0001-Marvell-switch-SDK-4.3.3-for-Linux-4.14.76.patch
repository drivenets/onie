+#ifdef CONFIG_MMIO_64BIT
 static inline void __raw_writeq(u64 val, volatile void __iomem *addr)
 {
 	asm volatile("str %x0, [%1]" : : "rZ" (val), "r" (addr));
 }
+#else
+static inline void __raw_writeq(u64 val, volatile void __iomem *addr)
+{
+	u32 *low, *high;
+
+	low = high = (u32 *)addr;
+#ifdef CONFIG_CPU_BIG_ENDIAN
+	low++;
+#else
+	high++;
+#endif
+	asm volatile("str %w0, [%1]" : : "rZ" (val & U32_MAX), "r" (low));
