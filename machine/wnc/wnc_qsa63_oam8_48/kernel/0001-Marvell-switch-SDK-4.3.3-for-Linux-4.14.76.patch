+#define tdm_fifo_content(s)	((s)->free_off - (s)->data_off)
+#define tdm_fifo_space(s)	((s)->fifo_sz - tdm_fifo_content(s))
+#define tdm_fifo_full(s)	(tdm_fifo_space(s) <= 0)
