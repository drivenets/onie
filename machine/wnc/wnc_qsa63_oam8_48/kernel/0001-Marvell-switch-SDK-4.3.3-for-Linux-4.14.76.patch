+int mv_pp2x_cls_hw_flow_hit_get(struct mv_pp2x_hw *hw,
+				int index,  unsigned int *cnt)
+{
+	if (mv_pp2x_range_validate(index, 0,
+				   MVPP2_CLS_FLOWS_TBL_SIZE) == MV_ERROR)
+		return MV_ERROR;
