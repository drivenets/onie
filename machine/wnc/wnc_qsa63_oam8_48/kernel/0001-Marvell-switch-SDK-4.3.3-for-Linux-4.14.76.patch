+static bool is_lbkvf(struct nicpf *nic, int vf)
+{
+	int lbk;
+
+	for (lbk = 0; lbk < NUM_LBK_IFS; lbk++) {
+		if (nic->lbk_vf[lbk] == vf)
+			return true;
+		continue;
+	}
+	return false;
+}
