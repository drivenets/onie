+static struct pki_t *pki_get_pf(u32 id)
+{
+	struct pki_t *pki = NULL;
+	struct pki_t *curr;
+
+	list_for_each_entry(curr, &octeontx_pki_devices, list) {
+		if (curr->id == id) {
+			pki = curr;
+			break;
+		}
+	}
