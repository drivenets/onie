+
+	if (val < CPT_COALESC_MIN_NUM_WAIT ||
+	    val > CPT_COALESC_MAX_NUM_WAIT)
+		return -EINVAL;
+
+	cfg = container_of(attr, struct lf_sysfs_cfg, coalesc_nw_attr);
+	lf = container_of(cfg, struct cptlf_info, sysfs_cfg);
+
+	cptlf_do_set_done_num_wait(lf, val);
