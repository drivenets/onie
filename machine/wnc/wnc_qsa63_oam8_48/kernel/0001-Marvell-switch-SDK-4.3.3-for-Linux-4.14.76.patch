+				buf_pool_ptr += params->buf_size;
+				if ((buf_pool_ptr - buf_pool_addr +
+				     params->buf_size) >= buf_pool_size)
+					buf_pool_ptr = buf_pool_addr;
+			}
+		}
+
+		for (i = 0; i < dst_cnt; i++) {
+			thread->dsts[i] = buf_pool_ptr;
+			buf_pool_ptr += params->buf_size;
+			if ((buf_pool_ptr - buf_pool_addr +
+			     params->buf_size) >= buf_pool_size)
+				buf_pool_ptr = buf_pool_addr;
+		}
