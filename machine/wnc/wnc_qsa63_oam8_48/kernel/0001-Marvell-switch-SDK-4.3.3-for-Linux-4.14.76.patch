+++ b/drivers/net/ethernet/cavium/common/cavium_ptp.c
@@ -0,0 +1,344 @@
+/*
+ * cavium_ptp.c - PTP 1588 clock on Cavium hardware
+ *
+ * Copyright (c) 2003-2015, 2017 Cavium, Inc.
+ *
