+
+	val = mv_pp2x_read(hw, MVPP2_RXQ_CONFIG_REG(prxq));
+	val &= ~MVPP21_RXQ_POOL_LONG_MASK;
+	val |= ((long_pool << MVPP21_RXQ_POOL_LONG_OFFS) &
+		    MVPP21_RXQ_POOL_LONG_MASK);
