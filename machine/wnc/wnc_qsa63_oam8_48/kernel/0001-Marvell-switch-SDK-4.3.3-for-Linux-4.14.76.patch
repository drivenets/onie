+
+&xor1 {
+	status = "disabled";
+};
+
+&uio_xor0 {
+	status = "disabled";
+};
+
+&uio_xor1 {
+	status = "disabled";
+};
+
+&cp0_pci_ep_uio {
+	status = "okay";
+};
+
+&cp0_pcie_ep {
+	status = "okay";
+};
+
