+void set_device_base_address(struct net_device *dev)
+{
+	struct mv_pp2x_port *port = netdev_priv(dev);
+
+	dev->mem_start = (unsigned long)port->priv->hw.phys_addr_start;
+	dev->mem_end = (unsigned long)port->priv->hw.phys_addr_end;
