+	} else {
+		/* set bit 15:14 to '00' for SGMII mode */
+		val = val & 0x3fff;
+		ret = phy_write(phydev, MII_VSC82X4_EXT_PAGE_19E, val);
+		if (ret < 0)
+			return ret;
+		/* Enable 4 ports MAC SGMII */
+		ret = phy_write(phydev, MII_VSC82X4_EXT_PAGE_18E,
+				MII_VSC8574_18G_SGMII);
+		if (ret < 0)
+			return ret;
+	}
