+static u64 get_coproc_clk(u8 node)
+{
+	u64 freq_in_mhz, sclk_freq;
+
+	/* Get SCLK */
+	sclk_freq = rst->get_sclk_freq(node);
+
+	freq_in_mhz = sclk_freq / (1000 * 1000);
+
+	return freq_in_mhz;
