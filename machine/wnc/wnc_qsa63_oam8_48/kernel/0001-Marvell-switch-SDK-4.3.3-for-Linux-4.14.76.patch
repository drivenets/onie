+	mutex_lock(&octeontx_sdp_lock);
+	list_for_each_entry(sdp_port, &octeontx_sdp_ports, list) {
+		if ((sdp_port) && (sdp_port->domain_id == domain_id) &&
+		    (sdp_port->dom_port_idx == port_idx))
+			break;
+	}
+	mutex_unlock(&octeontx_sdp_lock);
+	return sdp_port;
