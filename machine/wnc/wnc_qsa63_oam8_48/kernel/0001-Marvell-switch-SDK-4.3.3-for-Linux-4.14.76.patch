+/* respect TCMSCLKSEL, fall back to TDMCFG.useclk1, default clk0 */
+static int which_clk(int vno)
+{
+	struct tdm_bus *v = &veng[vno];
+
+	if (chk_vno(vno))
+		return 0;
+	if (v->clksel >= 0)
+		return v->clksel;
+	return v->tc.s.useclk1;
